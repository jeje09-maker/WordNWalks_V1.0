rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isSuperAdmin() {
    return isSignedIn() && (
      request.auth.token.email == 'darak303@naver.com' || 
      request.auth.uid == 'aRCEGOfj0lgkOES0KLywQwbsjLX2' ||
      request.auth.uid == '4PYWOqRk1dXhVt5NXe5DZq7Fa4Q2'
    );
  }
}