
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Word N Walks application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "status": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isGroupAdmin": { "type": "boolean" },
        "membershipIds": { "type": "array", "items": { "type": "string" } },
        "group": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["id", "email", "displayName"]
    },
    "Organization": {
      "title": "Organization",
      "type": "object",
      "description": "A church or a group organization.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["Church", "Group"] },
        "mainAdminEmail": { "type": "string" },
        "orgPhone": { "type": "string" },
        "address": { "type": "string" },
        "philosophy": { "type": "string" },
        "theology": { "type": "string" }
      },
      "required": ["id", "name", "type"]
    },
    "SmallGroup": {
      "title": "SmallGroup",
      "type": "object",
      "description": "A small group within an organization.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "leaderId": { "type": "string" },
        "leaderName": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "description": "A message within a small group chat room.",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "file", "youtube"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "OrgDailyContent": {
      "title": "OrgDailyContent",
      "type": "object",
      "description": "Daily content managed by organization admins.",
      "properties": {
        "passage": { "type": "string" },
        "materialTitle": { "type": "string" },
        "materialContent": { "type": "string" },
        "schedules": { "type": "array" }
      }
    },
    "GlobalBibleSegment": {
      "title": "GlobalBibleSegment",
      "type": "object",
      "description": "Shared Bible content generated by users or admins.",
      "properties": {
        "id": { "type": "string" },
        "passage": { "type": "string" },
        "title": { "type": "string" },
        "verses": { "type": "string" },
        "analysis": { "type": "string" },
        "meditationGuide": { "type": "string" },
        "questions": { "type": "array", "items": { "type": "string" } },
        "keyVerses": { "type": "array", "items": { "type": "string" } },
        "usageCount": { "type": "number" },
        "lastGeneratedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles."
    },
    "/organizations/{organizationId}": {
      "schema": { "$ref": "#/backend/entities/Organization" },
      "description": "Organization details."
    },
    "/organizations/{organizationId}/smallGroups/{groupId}": {
      "schema": { "$ref": "#/backend/entities/SmallGroup" },
      "description": "Small groups within the organization."
    },
    "/organizations/{organizationId}/smallGroups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/backend/entities/ChatMessage" },
      "description": "Chat messages for a small group."
    },
    "/organizations/{organizationId}/dailyContent/{dateStr}": {
      "schema": { "$ref": "#/backend/entities/OrgDailyContent" },
      "description": "Daily content for members."
    },
    "/bibleSegments/{segmentId}": {
      "schema": { "$ref": "#/backend/entities/GlobalBibleSegment" },
      "description": "Globally shared Bible meditation content."
    }
  }
}
